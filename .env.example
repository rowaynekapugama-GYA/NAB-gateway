# Copy to .env (or export) before running in live mode.
APP_MODE=demo                 # demo | live
APP_NAME=PayBridge
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/paybridge.db
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ADMIN_EMAIL=admin@paybridge.local
ADMIN_PASSWORD=admin1234

# Xero app (developer.xero.com) - needed for APP_MODE=live
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/app/xero/callback
XERO_WEBHOOK_KEY=

# NAB Transact endpoints (override if NAB's pack specifies different URLs)
NAB_TEST_ENDPOINT=https://transact.nab.com.au/test/xmlapi/payment
NAB_LIVE_ENDPOINT=https://transact.nab.com.au/live/xmlapi/payment
NAB_HOSTED_URL=https://transact.nab.com.au/live/hpp/payment

JOB_INTERVAL_MS=60000
JOB_TOKEN=change-me
